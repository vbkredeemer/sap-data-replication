{
  "sap": {
    "ashost": "sap-prod.firma.de",
    "sysnr": "10",
    "client": "100",
    "user": "RFC_USER",
    "password": "********",
    "lang": "EN"
  },
  "sql_server": {
    "connection_string": "Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=SAP_REPL;Trusted_Connection=yes;"
  },
  "ssh": {
    "host": "sap-prod.firma.de",
    "user": "sapadm",
    "key_file": "C:\\keys\\sap_id_rsa",
    "port": 22
  },
  "flatfile": {
    "transfer_method": "scp",
    "smb_share": "\\\\sap-server\\sap\\tmp"
  },
  "tables": [
    {
      "name": "MARA",
      "mode": "cdc",
      "key_fields": "MATNR",
      "chunk_size": 10000
    },
    {
      "name": "KNA1",
      "mode": "cdc",
      "key_fields": "KUNNR",
      "chunk_size": 10000
    },
    {
      "name": "VBAK",
      "mode": "timeframe",
      "delta_field": "AEDAT",
      "window": "day",
      "chunk_size": 10000
    },
    {
      "name": "VBAP",
      "mode": "flatfile",
      "delta_field": "AEDAT",
      "window": "day",
      "target_table": "VBAP",
      "replace_mode": "replace_window",
      "file_path": "/usr/sap/tmp/",
      "fields": "*"
    },
    {
      "name": "ACDOCA",
      "mode": "flatfile",
      "delta_field": "AEDAT",
      "window": "day",
      "target_table": "ACDOCA",
      "replace_mode": "replace_window",
      "file_path": "/usr/sap/tmp/",
      "fields": "*"
    },
    {
      "name": "T001W",
      "mode": "flatfile",
      "target_table": "T001W",
      "replace_mode": "replace_all",
      "file_path": "/usr/sap/tmp/",
      "fields": "*"
    }
  ]
}